# 复制为 .env 后按需修改
# 服务模式：/api/v1
API_PREFIX=/api/v1
APP_NAME=造价驻场工作台API
DEBUG=false

# 安全
SECRET_KEY=change-me-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=240

# 数据库（异步）
# 全栈：postgresql://postgres:123456@localhost:5432/cost_workbench
# 本地降级（无 Postgres 时）：sqlite+aiosqlite:///./cost.db
DATABASE_URL=sqlite+aiosqlite:///./cost.db

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL_SECONDS=300

# Celery 异步任务（broker/backend 默认复用 Redis；留空则回落到 REDIS_URL）
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=false

# 日志 / Loki 聚合（LOKI_ENABLED=true 时应用直接推送结构化日志到 Loki；
# 若用 Promtail 抓取容器 stdout，则保持 false 即可）
LOKI_ENABLED=false
LOKI_URL=http://localhost:3100
LOKI_SERVICE_NAME=cost-backend
LOKI_ENV=dev

# MinIO
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PATCH=cost-patch
MINIO_BUCKET_ATTACH=cost-attach
MINIO_SECURE=false

# 本地降级存储（USE_LOCAL_STORAGE=true 时生效，无需 MinIO）
USE_LOCAL_STORAGE=true
LOCAL_PATCH_DIR=./patches
LOCAL_UPLOAD_DIR=./uploads

# 历史数据迁移：待迁移源 JSON 路径（相对 backend 工作目录或绝对路径）；仅超级管理员可触发
MIGRATION_DATA_PATH=../data/user-data.json

# 初始管理员
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123
INIT_ADMIN_REAL_NAME=系统管理员
