# ===== 造价平台部署环境变量示例 =====
# 复制为 .env 后按实际情况修改： cp .env.example .env
# docker compose 会自动读取同目录下的 .env

# --- 发布镜像打标（发布闭环核心变量）---
# 镜像标签：部署时固定为某个发布版本；留空默认 latest
IMAGE_TAG=latest
# 镜像仓库前缀（可选）：留空则镜像名为 cost-backend:1.0.0（本地）；
# 设为 ghcr.io/<org>/ 则推送为 ghcr.io/<org>/cost-backend:1.0.0
DOCKER_REGISTRY=

# --- 基础设施凭据（演示默认值，生产请改）---
POSTGRES_DB=cost_workbench
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
REDIS_URL=redis://redis:6379/0
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_PATCH=cost-patch
MINIO_BUCKET_ATTACH=cost-attach
SECRET_KEY=change-me-in-prod
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123

# --- 可观测性 ---
LOKI_ENABLED=true
LOKI_URL=http://loki:3100
